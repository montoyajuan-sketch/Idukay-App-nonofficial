{
  "name": "idukay-app",
  "version": "0.8.2",
  "description": "App de escritorio no oficial que carga idukay.net. No tiene afiliación con Idukay ni con los colegios que lo usan.",
  "author": "Juan Pablo Montoya Tomala",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.idukay.app",
    "productName": "IdukayApp",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "notifications.html",
      "notifications-preload.js",
      "dnd-custom.html",
      "dnd-custom-preload.js",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-${version}-windows-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-windows-portable.${ext}"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "artifactName": "${productName}-${version}-mac.${ext}"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "build/icon.png",
      "category": "Education",
      "artifactName": "${productName}-${version}-linux.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "montoyajuan-sketch",
        "repo": "Idukay-App-nonofficial"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
